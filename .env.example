# Copy to .env.local and fill in from Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=

# Browser-safe key. New projects show this as `sb_publishable_...`; older ones
# label the same thing "anon". Either name is read, this one is preferred.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# server-only: employee creation + payslip generation. Never expose client-side.
SUPABASE_SERVICE_ROLE_KEY=

# Automatic credentials email (Resend — https://resend.com/api-keys)
# Without RESEND_API_KEY the account is still created; the admin just has to
# pass the Login ID and password on manually.
RESEND_API_KEY=
# Verified sender. resend.dev works for testing without a verified domain.
RESEND_FROM="Dayflow <onboarding@resend.dev>"
# Used to build the sign-in link inside the email.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Rehearse the onboarding email end to end, against a throwaway mailbox:
#   npm run send-credentials -- --name "Nikhil Rao" --wait
# The shared onboarding@resend.dev sender only delivers to the address that
# owns the Resend account, so to reach a temp mailbox verify a domain at
# https://resend.com/domains and point RESEND_FROM at it.
