# Copy to .env.local and fill in from Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=

# Browser-safe key. New projects show this as `sb_publishable_...`; older ones
# label the same thing "anon". Either name is read, this one is preferred.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# server-only: employee creation + payslip generation. Never expose client-side.
SUPABASE_SERVICE_ROLE_KEY=
